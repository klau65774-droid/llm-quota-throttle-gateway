# LLM Quota Throttle Gateway runtime configuration (safe local defaults)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_DB_PATH=data/gateway_state.sqlite3
GATEWAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GATEWAY_SEALED_BENCHMARK_DIR=../_sealed_benchmarks/llm-quota-throttle-gateway
GATEWAY_STORE_MAX_KEYS=2048
GATEWAY_DEFAULT_MODEL=gpt-4o-mini
GATEWAY_REDACTION_MODE=mask
GATEWAY_OTEL_SERVICE_NAME=llm-quota-throttle-gateway
